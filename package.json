{
  "name": "gha-migration-demo-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript utilities + jest tests for the GHA migration demo",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint \"frontend/src/**/*.ts\"",
    "test": "jest --ci --reporters=default --reporters=jest-junit"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.9",
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.15.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "ts-jest": "29.1.5",
    "typescript": "5.5.3"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "jest-junit.xml"
  }
}
